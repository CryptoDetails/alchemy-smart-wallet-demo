# Alchemy Dashboard -> your app -> API key
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Alchemy Dashboard -> Gas Sponsorship -> your policy -> Policy ID
NEXT_PUBLIC_ALCHEMY_POLICY_ID=

# Privy Dashboard -> your app -> App ID
NEXT_PUBLIC_PRIVY_APP_ID=
